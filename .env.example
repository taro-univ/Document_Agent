# ── LLM プロバイダー ──────────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxx

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxx

# GitHub Models (OpenAI SDK互換)
# https://github.com/settings/tokens → "Models" スコープを付与
GITHUB_TOKEN=github_pat_xxxxxxxxxx

# ── 検索 API ──────────────────────────────────────────────────────────
# Brave Search (推奨・無料プランあり) — https://api.search.brave.com/app/keys
BRAVE_API_KEY=BSAxxxxxxxxxx

# Google Custom Search (代替)
# https://console.cloud.google.com/ → Custom Search JSON API を有効化
# https://programmablesearchengine.google.com/ → 検索エンジンIDを取得
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
